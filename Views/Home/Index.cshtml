@model InventoryManagementSystem.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center mb-5">
    <h1 class="display-4">System Dashboard</h1>
    <p class="lead">Real-time inventory overview.</p>
</div>

<div class="row">
    <!-- Total Products Card -->
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm text-center">
            <div class="card-header bg-primary text-white">Total Products</div>
            <div class="card-body">
                <h2 class="card-title">@Model.TotalProducts</h2>
            </div>
        </div>
    </div>

    <!-- Low Stock Card -->
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm text-center">
            <div class="card-header bg-danger text-white">Low Stock Alerts</div>
            <div class="card-body">
                <h2 class="card-title">@Model.LowStockItems</h2>
            </div>
        </div>
    </div>

    <!-- Inventory Value Card -->
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm text-center">
            <div class="card-header bg-success text-white">Inventory Value</div>
            <div class="card-body">
                <h2 class="card-title">$@Model.TotalInventoryValue.ToString("N2")</h2>
            </div>
        </div>
    </div>

    <!-- Total Revenue Card -->
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm text-center">
            <div class="card-header bg-info text-white">Total Sales</div>
            <div class="card-body">
                <h2 class="card-title">$@Model.TotalSalesRevenue.ToString("N2")</h2>
            </div>
        </div>
    </div>
</div>